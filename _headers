/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.onesignal.com https://cdn.jsdelivr.net https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://onesignal.com https://*.onesignal.com https://api.resend.com https://raw.githubusercontent.com https://api.github.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://cloudflareinsights.com https://static.cloudflareinsights.com; frame-src 'self' blob: https://calendar.google.com https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.instagram.com; media-src 'self' https:; worker-src 'self' blob:; manifest-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Assets statiques avec fingerprint dans le nom → cache long
/assets/*
  Cache-Control: public, max-age=2592000, must-revalidate

/css/*
  Cache-Control: public, max-age=604800, must-revalidate

/js/*
  Cache-Control: public, max-age=604800, must-revalidate

# Favicon/manifest — cache moyen
/favicon.ico
  Cache-Control: public, max-age=604800

/manifest.json
  Cache-Control: public, max-age=604800

# Aucune mise en cache pour les fichiers dynamiques
/service-worker.js
  Cache-Control: no-store, no-cache, must-revalidate

/admin.html
  Cache-Control: no-store, no-cache, must-revalidate

/_data/*
  Cache-Control: no-store, no-cache, must-revalidate
